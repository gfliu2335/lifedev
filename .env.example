# Claude API配置
CLAUDE_API_KEY=your_claude_api_key_here

# ElevenLabs API配置（英文配音）
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Google TTS配置（中文/日文配音）
GOOGLE_APPLICATION_CREDENTIALS=path/to/google-credentials.json

# 账号信息（谨慎保管）
DOUYIN_ACCOUNTS=[]  # JSON格式：[{"phone": "xxx", "password": "xxx"}]
YOUTUBE_ACCOUNTS=[]  # JSON格式
TIKTOK_ACCOUNTS=[]   # JSON格式

# 代理配置（用于访问国外平台）
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=

# 数据库配置
DATABASE_URL=sqlite:///./data/uploads_log.db

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# 系统配置
VIDEO_OUTPUT_DIR=./data/videos
SCRIPT_OUTPUT_DIR=./data/scripts
MAX_WORKERS=4
